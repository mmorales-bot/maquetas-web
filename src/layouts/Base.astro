---
import '../styles/global.css';
import { SITE } from '../site.config';
import { url } from '../utils';
import { THEME, MOSTRAR_SELECTOR_DISENO, RUTAS_DISENO } from '../theme';

interface Props { title?: string; description?: string; }
const { title, description = SITE.descripcion } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.nombre}` : `${SITE.nombre} — ${SITE.eslogan}`;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const links = [
  { href: '', label: 'Inicio' },
  { href: 'catalogo', label: 'Catálogo' },
  { href: 'nosotros', label: 'Nosotros' },
];
// Raíz común de ambos diseños (para el selector de diseño)
const raizSitio = import.meta.env.BASE_URL.replace(/\/$/, '').replace(/\/premium$/, '');
const enlaceDiseno = (t: 'industrial' | 'premium') => `${raizSitio}/${RUTAS_DISENO[t]}`;
const isActive = (href: string) =>
  href === '' ? path === '/' : path.startsWith('/' + href);
---
<!doctype html>
<html lang="es" data-theme={THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta name="theme-color" content="#0B2A5B" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href={THEME === 'premium'
      ? 'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap'
      : 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap'} />
  </head>
  <body>
    {MOSTRAR_SELECTOR_DISENO && (
      <div class="design-switch">
        <span>Vista previa de diseño:</span>
        <a href={enlaceDiseno('industrial')} aria-current={THEME === 'industrial' ? 'true' : undefined}>Industrial</a>
        <a href={enlaceDiseno('premium')} aria-current={THEME === 'premium' ? 'true' : undefined}>Premium</a>
      </div>
    )}
    <header class="site-header">
      <nav class="container nav" aria-label="Principal">
        <a class="brand" href={url()} aria-label={`${SITE.nombre} — inicio`}>
          <img src={url('logo/didactek-horizontal-sin-lema.svg')} alt={SITE.nombre} height="48" />
        </a>
        <button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-links">☰</button>
        <ul class="nav-links" id="nav-links">
          {links.map((l) => (
            <li><a href={url(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
          <li><a class="btn btn-primary" href={url('contacto')}>Pedir presupuesto</a></li>
        </ul>
      </nav>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <img class="footer-logo" src={url('logo/didactek-horizontal-blanco.svg')} alt={SITE.nombre} />
            <p>{SITE.descripcion}</p>
          </div>
          <div>
            <h4>Navegación</h4>
            <ul>
              <li><a href={url('catalogo')}>Catálogo</a></li>
              <li><a href={url('nosotros')}>Nosotros</a></li>
              <li><a href={url('contacto')}>Contacto</a></li>
            </ul>
          </div>
          <div>
            <h4>Contacto</h4>
            <ul>
              <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
              <li><a href={`tel:${SITE.telefono.replace(/\s/g, '')}`}>{SITE.telefono}</a></li>
              <li>{SITE.direccion}</li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">© {new Date().getFullYear()} {SITE.nombre}. Todos los derechos reservados.</div>
      </div>
    </footer>

    <script>
      const btn = document.querySelector('.menu-toggle');
      const menu = document.getElementById('nav-links');
      btn?.addEventListener('click', () => {
        const open = menu?.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(!!open));
      });
    </script>
  </body>
</html>
