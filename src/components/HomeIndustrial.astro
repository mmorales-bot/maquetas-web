---
import type { CollectionEntry } from 'astro:content';
import { SITE, FAMILIAS } from '../site.config';
import { url } from '../utils';
interface Props { todas: CollectionEntry<'maquetas'>[]; }
const { todas } = Astro.props;
const destacadas = todas.filter((m) => m.data.destacada).slice(0, 6);
const principal = destacadas[0] ?? todas[0];
const familias = FAMILIAS.filter((f) => todas.some((m) => m.data.familias.includes(f)));
---
<section class="hero">
  <div class="container hero-grid">
    <div>
      <span class="eyebrow">Formación Profesional · Universidad</span>
      <h1 style="margin-top:14px">Maquetas didácticas con tecnología industrial real</h1>
      <p>{SITE.descripcion}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={url('catalogo')}>Ver catálogo</a>
        <a class="btn btn-outline" href={url('contacto')}>Solicitar información</a>
      </div>
    </div>
    {principal && (
      <a class="hero-img" href={url(`maquetas/${principal.id}`)}>
        <img src={url(principal.data.imagen)} alt={principal.data.titulo} width="1600" height="960" />
      </a>
    )}
  </div>
</section>

<section class="section">
  <div class="container">
    <span class="eyebrow">Destacadas</span>
    <h2>Maquetas destacadas</h2>
    <div class="hcards" style="margin-top:24px">
      {destacadas.map((m) => (
        <article class="hcard">
          <img src={url(m.data.imagen)} alt={m.data.titulo} loading="lazy" />
          <div class="hcard-body">
            <span class="ref">{m.data.referencia} · {m.data.tematica}</span>
            <h3><a href={url(`maquetas/${m.id}`)}>{m.data.titulo}</a></h3>
            <p>{m.data.resumen}</p>
            <div class="tags">{m.data.niveles.map((n) => <span class="tag tag-level">{n}</span>)}</div>
          </div>
        </article>
      ))}
    </div>
    <p style="margin-top:28px"><a class="btn btn-outline" href={url('catalogo')}>Ver catálogo técnico completo →</a></p>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <span class="eyebrow">Por qué elegirnos</span>
    <h2>Pensadas para enseñar</h2>
    <div class="features" style="margin-top:28px">
      <div class="feature"><div class="icon">🎓</div><h3>Alineadas con el currículo</h3><p>Cada maqueta indica los ciclos formativos y grados a los que da respuesta.</p></div>
      <div class="feature"><div class="icon">🏭</div><h3>Componentes industriales</h3><p>El alumnado trabaja con los mismos equipos que encontrará en la empresa.</p></div>
      <div class="feature"><div class="icon">📘</div><h3>Guías de prácticas</h3><p>Documentación técnica y prácticas progresivas listas para el profesorado.</p></div>
      <div class="feature"><div class="icon">🛠️</div><h3>Soporte y formación</h3><p>Instalación, formación al profesorado y asistencia técnica posventa.</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <span class="eyebrow">Familias profesionales</span>
    <h2>Explora por familia</h2>
    <div class="tags" style="margin-top:16px; gap:10px">
      {familias.map((f) => <a class="btn btn-outline" href={url(`catalogo?familia=${encodeURIComponent(f)}`)}>{f}</a>)}
    </div>
  </div>
</section>

<section class="container">
  <div class="cta">
    <div>
      <h2 style="margin:0 0 6px">¿Equipando un aula o laboratorio?</h2>
      <p>Cuéntanos qué necesitas y te preparamos una propuesta a medida para tu centro.</p>
    </div>
    <a class="btn btn-primary" href={url('contacto')}>Pedir presupuesto</a>
  </div>
</section>
