---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HomeIndustrial from '../components/HomeIndustrial.astro';
import HomePremium from '../components/HomePremium.astro';
import { THEME } from '../theme';

const todas = (await getCollection('maquetas')).sort((a, b) => a.data.orden - b.data.orden);
---
<Base>
  {THEME === 'premium' ? <HomePremium todas={todas} /> : <HomeIndustrial todas={todas} />}
</Base>
